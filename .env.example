# GasQ Environment Configuration Template
# Copy this file to .env and customize for your deployment environment.

# Environment: "development", "test", or "production"
GASQ_ENVIRONMENT=development

# Database Connection:
# SQLite (Local Development):
GASQ_DATABASE_URL=sqlite:///./lpg_queue.db
# PostgreSQL (Production e.g. Neon, Render, Supabase):
# GASQ_DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/gasq?sslmode=require

# Security: JWT Signing Secret (must be at least 32 characters in production)
GASQ_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars!
GASQ_ACCESS_TOKEN_TTL_SECONDS=900
GASQ_REFRESH_TOKEN_TTL_DAYS=7
GASQ_TOKEN_TTL_SECONDS=43200

# CORS Allowed Origins (Comma-separated)
GASQ_CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001,http://localhost:3000

# Google OpenID Connect (Optional - get from Google Cloud Console)
GASQ_GOOGLE_CLIENT_ID=

# Email OTP Service: "console" (logs to server stdout) or "smtp" (Brevo, Gmail, SendGrid free tier)
GASQ_MAIL_PROVIDER=console
GASQ_SMTP_HOST=smtp-relay.brevo.com
GASQ_SMTP_PORT=587
GASQ_SMTP_USERNAME=
GASQ_SMTP_PASSWORD=

# SMS Service Feature Flag (Console provider by default, zero cost)
GASQ_PHONE_OTP_ENABLED=false

# Bootstrap Superadmin Account (Automatically seeded if not already present)
GASQ_ADMIN_EMAIL=admin@gasq.local
GASQ_ADMIN_PASSWORD=ChangeMeAdmin12345!

# Rate Limiting Configuration
GASQ_RATE_LIMIT_WINDOW_SECONDS=60
GASQ_RATE_LIMIT_REQUESTS=600
GASQ_AUTH_RATE_LIMIT_REQUESTS=60
GASQ_QUEUE_RATE_LIMIT_REQUESTS=120
